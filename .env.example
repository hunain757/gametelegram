# Copy this file to .env and fill in your keys. NEVER upload .env to GitHub.
# (start.bat does this for you on the first run.)

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: more Gemini keys (comma separated) – each key has its own free quota, the bot rotates them
GEMINI_API_KEYS=
# Other free AI APIs (much bigger free quota than Gemini). With a key here the desk uses them first and
# Gemini becomes the fallback. Mistral: console.mistral.ai/api-keys · Groq: console.groq.com/keys
MISTRAL_API_KEY=
GROQ_API_KEY=
# Optional: more keys (comma separated, from other accounts) and the models to use
# MISTRAL_API_KEYS=
# MISTRAL_MODELS=mistral-large-latest,mistral-medium-latest,mistral-small-latest
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Twelve Data key for gold prices (https://twelvedata.com - free plan works)
TWELVEDATA_API_KEY=

# ---------------- Optional settings ----------------
# Markets to trade: XAUUSD (gold, Twelve Data) and/or BTCUSD (bitcoin, Binance – free, 24/7)
MARKETS=XAUUSD,BTCUSD
# Which signal types to scan: scalp, intraday, swing
STYLES=scalp,intraday,swing
# Scan every N minutes (5 fits the Twelve Data free plan)
SCAN_INTERVAL_MINUTES=5

# Rule engine confluence score (0-100) needed before the AI desk reviews a setup
MIN_ENGINE_SCORE=55
# Head Trader AI confidence needed to send a signal
MIN_CONFIDENCE=70
# Share of the analysts that must vote TAKE, written "out of 8": 5 = 5/8 = 62 % (12 of the 18 analysts)
MIN_AGENT_VOTES=5
# TP1 must be at least this many times the risk
MIN_RISK_REWARD=1.5
# Strict mode: only trades where trend (EMA 50/200), Supertrend, ADX, a liquidity sweep and a
# confirmation candle all agree. Fewer signals, fewer losses. on/off
STRICT_MODE=on
# If Gemini is completely down, still send setups with an engine score >= this (0 = never)
ENGINE_ONLY_SCORE=85

# Gemini models. Analysts use the lite models (split across your keys); verifiers, Head Trader and
# Auditor use the strong ones. The free plan allows only ~5 requests/minute per model per key.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_RPM_PER_MODEL=4

# Volume source: PAXG/USDT on Binance (tokenized gold). Empty = no volume analysis.
VOLUME_SYMBOL=PAXGUSDT
SYMBOL=XAU/USD

# News filter: pause new signals this many minutes before/after high-impact news (0 = off)
NEWS_BLACKOUT_MIN=30
NEWS_CURRENCIES=USD
# RSS feeds for gold / USD / Fed headlines (comma separated, empty = off)
# Extra RSS feeds (the built-in forex, world-news and crypto feeds are always used)
NEWS_FEEDS=
# AI briefing with chart at London (07:02 UTC) and New York (12:32 UTC) open: on/off
BRIEFINGS=on
# Ounces per 1.00 lot at your broker (almost always 100) – used for lot sizes
CONTRACT_SIZE=100

# Daily report hour (UTC, Mon-Fri)
DAILY_REPORT_HOUR_UTC=21
# Telegram channel to also post signals to, e.g. @mygoldsignals or -100123456789 (bot must be admin there)
CHANNEL_ID=
# Your Telegram user id(s), comma separated: admin tools + error alerts.
# Empty = the first person who sends /start becomes the owner.
ADMIN_IDS=

# Only if Telegram is blocked on your internet and you don't use a VPN:
# a SOCKS5 or HTTP proxy, e.g. socks5://127.0.0.1:1080 (MTProto proxies from the Telegram app do NOT work)
PROXY_URL=

# Local live dashboard (agents, activity, chart): http://localhost:8080 – only on this computer.
# DASHBOARD_PORT=0 turns it off; DASHBOARD_OPEN=off stops it opening the browser automatically.
DASHBOARD_PORT=8080
DASHBOARD_OPEN=on
