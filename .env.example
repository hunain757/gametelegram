# Copy this file to .env and fill in your keys. NEVER upload .env to GitHub.
# (start.bat does this for you on the first run.)

# ---------------- AI keys (at least one) ----------------
# Mistral (recommended, biggest free quota): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Groq (optional, very fast): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (optional fallback): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# More keys (comma separated, each from another account) and the models to use
# MISTRAL_API_KEYS=
# GROQ_API_KEYS=
# GEMINI_API_KEYS=
# MISTRAL_MODELS=mistral-large-latest,mistral-medium-latest,mistral-small-latest
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# USE_GEMINI=off

# ---------------- Market data ----------------
# Twelve Data key for gold prices (https://twelvedata.com - free plan works). Bitcoin needs no key.
TWELVEDATA_API_KEY=

# ---------------- Optional settings ----------------
# Markets: XAUUSD (gold) and/or BTCUSD (bitcoin, 24/7)
MARKETS=XAUUSD,BTCUSD
# Signal types: scalp, intraday, swing (each can also be switched on/off on the website)
STYLES=scalp,intraday,swing
# Scan every N minutes (5 fits the Twelve Data free plan)
SCAN_INTERVAL_MINUTES=5

# Engine confluence score (0-100) needed before the AI desk reviews a setup
MIN_ENGINE_SCORE=55
# Head Trader confidence and desk conviction (weighted average of every agent) needed for a signal
MIN_CONFIDENCE=70
MIN_CONVICTION=58
# Share of the analysts that must vote TAKE, written "out of 8": 5 = 62 %
MIN_AGENT_VOTES=5
# TP1 must be at least this many times the risk
MIN_RISK_REWARD=1.5
# Strict engine mode (every filter must agree before the desk sees a setup): on/off
STRICT_MODE=off
# If the AI desk is down, still publish setups with an engine score >= this (0 = never)
ENGINE_ONLY_SCORE=85

# Language of the AI's explanation on signals and market views ("Roman Urdu", "simple English", ...)
EXPLAIN_LANGUAGE=Roman Urdu

# Gemini models (only used when a Gemini key is set)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_RPM_PER_MODEL=4

# Gold volume source: PAXG/USDT on Binance (tokenized gold). Empty = no volume analysis.
VOLUME_SYMBOL=PAXGUSDT
SYMBOL=XAU/USD
# Ounces per 1.00 lot at your broker (almost always 100) - used for lot sizes on the website
CONTRACT_SIZE=100

# News filter: pause new signals this many minutes before/after high-impact news (0 = off)
NEWS_BLACKOUT_MIN=30
NEWS_CURRENCIES=USD
# Extra RSS feeds (the built-in forex, world-news and crypto feeds are always used)
NEWS_FEEDS=

# The website: http://localhost:8080 - only on this computer. DASHBOARD_OPEN=off stops it opening the
# browser automatically.
DASHBOARD_PORT=8080
DASHBOARD_OPEN=on
