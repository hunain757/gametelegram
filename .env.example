# Copy this file to .env and fill in your keys. NEVER upload .env to GitHub.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Twelve Data key for gold prices (https://twelvedata.com - free plan works)
TWELVEDATA_API_KEY=

# --- Optional settings ---
GEMINI_MODEL=gemini-2.5-flash
SYMBOL=XAU/USD
SCAN_INTERVAL_MINUTES=15
# Signal is sent only if AI confidence >= this
MIN_CONFIDENCE=70
# Take-profit 1 must be at least this many times the risk
MIN_RISK_REWARD=1.5
# No new signal for this many minutes after one is sent
COOLDOWN_MINUTES=60
# Telegram channel to also post signals to, e.g. @mygoldsignals or -100123456789 (bot must be admin there)
CHANNEL_ID=
# Your Telegram user id(s), comma separated. Only these can use /scan. Empty = anyone.
ADMIN_IDS=
