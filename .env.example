# Copy this file to .env and fill in your keys. NEVER upload .env to GitHub.
# (start.bat does this for you on the first run.)

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Twelve Data key for gold prices (https://twelvedata.com - free plan works)
TWELVEDATA_API_KEY=

# ---------------- Optional settings ----------------
# Which signal types to scan: scalp, intraday, swing
STYLES=scalp,intraday,swing
# Scan every N minutes (5 fits the Twelve Data free plan)
SCAN_INTERVAL_MINUTES=5

# Rule engine confluence score (0-100) needed before the AI desk reviews a setup
MIN_ENGINE_SCORE=55
# Head Trader AI confidence needed to send a signal
MIN_CONFIDENCE=70
# How many of the 8 specialist agents must vote TAKE
MIN_AGENT_VOTES=5
# TP1 must be at least this many times the risk
MIN_RISK_REWARD=1.5
# If Gemini is completely down, still send setups with an engine score >= this (0 = never)
ENGINE_ONLY_SCORE=85

# Gemini models. The Head Trader uses GEMINI_MODEL; the 8 specialists are spread over the
# fallback models (the free plan allows only ~5 requests/minute per model).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.7-flash
GEMINI_RPM_PER_MODEL=4

# Volume source: PAXG/USDT on Binance (tokenized gold). Empty = no volume analysis.
VOLUME_SYMBOL=PAXGUSDT
SYMBOL=XAU/USD

# News filter: pause new signals this many minutes before/after high-impact news (0 = off)
NEWS_BLACKOUT_MIN=30
NEWS_CURRENCIES=USD
# AI briefing with chart at London (07:02 UTC) and New York (12:32 UTC) open: on/off
BRIEFINGS=on
# Ounces per 1.00 lot at your broker (almost always 100) – used for lot sizes
CONTRACT_SIZE=100

# Daily report hour (UTC, Mon-Fri)
DAILY_REPORT_HOUR_UTC=21
# Telegram channel to also post signals to, e.g. @mygoldsignals or -100123456789 (bot must be admin there)
CHANNEL_ID=
# Your Telegram user id(s), comma separated: admin tools + error alerts.
# Empty = the first person who sends /start becomes the owner.
ADMIN_IDS=

# Only if Telegram is blocked on your internet and you don't use a VPN:
# a SOCKS5 or HTTP proxy, e.g. socks5://127.0.0.1:1080 (MTProto proxies from the Telegram app do NOT work)
PROXY_URL=

# Local live dashboard (agents, activity, chart): http://localhost:8080 – only on this computer.
# DASHBOARD_PORT=0 turns it off; DASHBOARD_OPEN=off stops it opening the browser automatically.
DASHBOARD_PORT=8080
DASHBOARD_OPEN=on
